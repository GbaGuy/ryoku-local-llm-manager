{
  "id": "strata",
  "name": "Strata",
  "version": "0.3.0",
  "author": "guyb <blumguy111@gmail.com>",
  "description": "Finds local model engines (Strata, TabbyAPI, llama.cpp) and their models; pick one, start or stop it.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 360
  },
  "files": [
    "bin/strata-models"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ],
    "network": [
      "127.0.0.1"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Strata"
  },
  "dependencies": {
    "commands": [
      "systemctl",
      "ss",
      "pkill"
    ]
  },
  "metadata": {
    "settings": []
  }
}

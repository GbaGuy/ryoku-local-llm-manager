#!/bin/sh
# Finds every installed engine and its ready models; one model runs at a time.
#
# strata-models list <state>          one "key<TAB>engine<TAB>label<TAB>port<TAB>unit<TAB>path" line per model
# strata-models current <state>       print the selected model key ("engine:name")
# strata-models use <key> <state>     select a model; restarts the server if one is running
# strata-models start <state>         start the selected model (stops every other model server)
# strata-models run <key> <state>     select a model and start it
# strata-models stop                  stop every model server
#
# Engines: Strata (~/Strata, strata.service), TabbyAPI (~/tabbyAPI, tabby.service),
# llama.cpp (llama-server, llama.service). Each unit reads <state>/<engine>.env for its model and port.
strata="$HOME/Strata"
tabby="$HOME/tabbyAPI"
gguf_dirs="$HOME/llm-src/gguf $HOME/models"
units="strata.service tabby.service llama.service"

# a stable port per model, kept in <state>/ports ("key port"); 8080 is Steam's, skip ports in use
port_for() { # key state [fixed]
    [ -n "$3" ] && { echo "$3"; return; }
    p=$(awk -v k="$1" '$1 == k { print $2 }' "$2/ports" 2>/dev/null)
    [ -n "$p" ] && { echo "$p"; return; }
    used=$( { cat "$strata"/strata-*.json 2>/dev/null | sed -n 's/.*"port": *\([0-9]*\).*/\1/p'
              awk '{ print $2 }' "$2/ports" 2>/dev/null
              ss -Hltn 2>/dev/null | awk '{ n = split($4, a, ":"); print a[n] }'; } | sort -u)
    p=8081
    while [ "$p" = 8080 ] || echo "$used" | grep -qx "$p"; do p=$((p + 1)); done
    mkdir -p "$2" && echo "$1 $p" >> "$2/ports"
    echo "$p"
}

row() { # key engine label port unit path
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$@"
}

list() { # state
    if [ -f "$strata/serve/server.py" ]; then
        for f in "$strata"/strata-*.json; do
            [ -e "$f" ] || continue
            n=$(basename "$f" .json | sed 's/^strata-//')
            fixed=$(sed -n 's/.*"port": *\([0-9]*\).*/\1/p' "$f" | head -n 1)
            row "strata:$n" Strata "$n" "$(port_for "strata:$n" "$1" "${fixed:-8081}")" strata.service "$f"
        done
    fi
    if [ -x "$tabby/run.sh" ]; then
        for d in "$tabby"/models/*/; do
            d=${d%/}
            # a finished download: config and shards present, none still partial in hf's cache
            [ -f "$d/config.json" ] && ls "$d"/*.safetensors >/dev/null 2>&1 || continue
            ls "$d"/.cache/huggingface/download/*.incomplete >/dev/null 2>&1 && continue
            n=$(basename "$d")
            row "tabby:$n" TabbyAPI "$(echo "$n" | sed 's/[-_.]exl3.*//I')" "$(port_for "tabby:$n" "$1")" tabby.service "$d"
        done
    fi
    if command -v llama-server >/dev/null; then
        for f in $(for g in $gguf_dirs; do ls "$g"/*.gguf 2>/dev/null; done); do
            n=$(basename "$f" .gguf)
            case "$n" in *mmproj*|*imatrix*) continue ;; *-0000[2-9]-of-*|*-000[1-9][0-9]-of-*) continue ;; esac
            row "llama:$n" llama.cpp "$(echo "$n" | sed 's/\.i1-.*//; s/-00001-of-.*//')" "$(port_for "llama:$n" "$1")" llama.service "$f"
        done
    fi
    return 0
}

current() { # state
    k=$(cat "$1/current" 2>/dev/null) || k=strata:coder-iq1_m
    case "$k" in *:*) echo "$k" ;; *) echo "strata:$k" ;; esac   # older files hold a bare Strata name
}
lookup() { list "$2" | awk -F '\t' -v k="$1" '$1 == k'; }

write_env() { # row state
    port=$(echo "$1" | cut -f4); path=$(echo "$1" | cut -f6); key=$(echo "$1" | cut -f1)
    case "$key" in
    strata:*) printf 'STRATA_CONFIG=%s\nSTRATA_PORT=%s\n' "$path" "$port" > "$2/model.env" ;;
    tabby:*) printf 'TABBY_MODEL=%s\nTABBY_PORT=%s\n' "${key#tabby:}" "$port" > "$2/tabby.env" ;;
    llama:*) printf 'LLAMA_MODEL=%s\nLLAMA_PORT=%s\n' "$path" "$port" > "$2/llama.env" ;;
    esac
}

start() { # state
    r=$(lookup "$(current "$1")" "$1")
    [ -n "$r" ] || { echo "model not ready" >&2; exit 2; }
    unit=$(echo "$r" | cut -f5)
    write_env "$r" "$1"
    for u in $units; do [ "$u" = "$unit" ] || systemctl --user stop "$u" 2>/dev/null; done
    # servers started by hand (run-*.sh, setup.sh, a terminal) sit outside the units; stop them too
    pkill -u "$(id -u)" -f "$strata/serve/server.py|$strata/engine/strata|tabbyAPI/main.py|llama-server" 2>/dev/null
    systemctl --user restart "$unit"
}

case "$1" in
list) list "$2" ;;
current) current "$2" ;;
use)
    case "$2" in ''|*[!A-Za-z0-9._:-]*) echo "bad model key" >&2; exit 2 ;; esac
    [ -n "$(lookup "$2" "$3")" ] || { echo "no such model" >&2; exit 2; }
    mkdir -p "$3" && echo "$2" > "$3/current"
    for u in $units; do
        systemctl --user is-active --quiet "$u" && { start "$3"; break; }
    done ;;
start) start "$2" ;;
run)
    case "$2" in ''|*[!A-Za-z0-9._:-]*) echo "bad model key" >&2; exit 2 ;; esac
    [ -n "$(lookup "$2" "$3")" ] || { echo "no such model" >&2; exit 2; }
    mkdir -p "$3" && echo "$2" > "$3/current"
    start "$3" ;;
stop) systemctl --user stop $units 2>/dev/null ;;
*) echo "usage: $0 list|current|use|start|stop (see the header)" >&2; exit 2 ;;
esac
